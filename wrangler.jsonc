{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agent-mail-personal",
  "main": "worker/entry.ts",
  "compatibility_date": "2026-11-10",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agent-mail-personal",
    "database_id": "00000000-0000-0000-0000-000000000000",
    "migrations_dir": "migrations"
  }],
  "r2_buckets": [{ "binding": "MAIL_BLOBS", "bucket_name": "agent-mail-personal" }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "MAIL_DOMAIN": "agent.example.com",
    "CONSOLE_ORIGIN": "https://console.example.com",
    "API_ORIGIN": "https://api.example.com",
    "OWNER_EMAIL": "CHANGE_ME",
    "ACCESS_TEAM_DOMAIN": "https://CHANGE_ME.cloudflareaccess.com",
    "ACCESS_AUD": "CHANGE_ME",
    "OAUTH_CIMD_ALLOWED_HOSTS": ""
  }
}
